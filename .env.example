# zixun 运行环境配置模板
#
# 复制为项目根目录 .env 后按当前机器修改。
# 算法/实验参数（lookback、sample_count、temperature、top_p、seed 等）
# 不放在这里，直接修改 kronos/three_day_json_forecast.py 的 DEFAULT_*，
# 或通过其 CLI 参数临时覆盖。

# ---------- 项目路径 ----------
# 相对路径均相对于项目根目录 /Users/eurus/Code/zixun 解析。
ZIXUN_SOURCES_CONFIG=config/sources.yaml
ZIXUN_FILTERS_CONFIG=config/filters.yaml
ZIXUN_DATA_DIR=data
ZIXUN_DB_PATH=data/zixun.db
ZIXUN_ARTICLES_DIR=articles
ZIXUN_LOGS_DIR=logs
ZIXUN_KLINE_DIR=kline_data
ZIXUN_OUTPUTS_DIR=outputs
ZIXUN_RUN_STATUS_PATH=data/run.status.json
ZIXUN_FORECAST_STATUS_PATH=data/forecast.status.json
ZIXUN_PANEL_RUN_LOG=logs/panel-run.log
ZIXUN_FORECAST_LOG=logs/forecast.log
ZIXUN_RUN_SCRIPT=scripts/run.sh

# ---------- Python / Kronos 运行环境 ----------
# 默认使用启动 Streamlit 的 Python；需要隔离解释器时填写路径。
# KRONOS_PYTHON=.venv/bin/python
KRONOS_DEVICE=auto
# 首次运行可设为 false 允许从 Hugging Face 下载权重；权重缓存完成后可改为 true。
KRONOS_LOCAL_FILES_ONLY=false
# 可选：指定 Hugging Face cache 目录；为空时使用 Hugging Face 默认缓存。
# KRONOS_CACHE_DIR=/path/to/huggingface-cache

# ---------- 资讯校准运行配置 ----------
# 这些是检索、LLM 端点和校准边界配置；预测模型的采样/窗口等参数不在这里。
CALIBRATION_LOOKBACK_DAYS=3
CALIBRATION_MAX_ARTICLES=15
CALIBRATION_FALLBACK_TO_BLACK_SECTOR=true
CALIBRATION_AI_SUMMARY_CAP=200
CALIBRATION_PREVIEW_CAP=160
CALIBRATION_BASE_URL=https://api.deepseek.com/v1
CALIBRATION_MODEL=deepseek-chat
CALIBRATION_TEMPERATURE=0.3
CALIBRATION_MAX_RETRIES=2
CALIBRATION_TIMEOUT_SECONDS=60
CALIBRATION_MAX_PROB_SHIFT=0.10
CALIBRATION_MAX_RETURN_SHIFT=0.015
CALIBRATION_PROB_CLAMP=0.0,1.0
CALIBRATION_RETURN_CLAMP=-0.10,0.10

# ---------- LLM ----------
# 不要把真实密钥提交到仓库；在本机 .env 中填写，或通过外部环境变量注入。
OPENAI_API_KEY=
